# Normalize documentation, preserve all bytes covered by runtime manifests
# and the room build fingerprint, including third-party LICENSE files.
* text=auto
/web/** -text
/server.py -text
/lan_server.py -text
/lan_relay.py -text

# Windows launchers and build resources must retain their original bytes.
*.bat -text
*.wasm -text
*.gz -text
*.hdi -text
*.com -text
*.exe -text
*.bin -text
*.opus -text
*.png -text
*.jpg -text
*.bmp -text
*.woff -text
*.woff2 -text

# Preserve deployed Runtime bytes, including manifest-covered line endings.
/web/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Generated vendor code retains upstream whitespace and byte identities.
/web/vendor/** whitespace=-blank-at-eol,cr-at-eol
