# Upload only the ready-to-run distribution. Development files remain local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README-PUBLIC.md
!/三星平板性能优化记录.md
!/web/
!/server.py
!/lan_server.py
!/relay_server.py
!/turn_service.py
!/public_tunnel.py
!/configure_turn.py
!/requirements-relay.txt
!/start.bat
!/start-lan.bat
!/start-public-tunnel.bat
!/configure-turn.bat

# All modes share the patched runtime disk. The development baseline stays local.
/web/disks/*
!/web/disks/th01-multiorb.hdi.gz
/web/baseline.json

# Keep runtime scripts (including imported qa.js), fonts, music, JS/WASM,
# licenses and manifests. Exclude development output copied into web/.
/web/baseline/
/web/build/
/web/extracted/
/web/reports/
/web/screenshots/
/web/tools/
/web/vendor-source/
/web/**/test-results/
/web/**/playwright-report/
/web/**/guest-*.wasm
/web/**/extra-probe.wasm
/web/**/extra-raw.wasm
/web/**/*.wat
/web/**/*.lst

# Never upload local credentials, generated URLs or caches inside allowed folders.
turn-config.local.json
public-test-url.txt
__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.ruff_cache/
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.swp
*.bak
*.orig
*~
.idea/
.vscode/
.env
.env.*
