# Ready-to-run DOSBox-X release, following th04-coop-lab's root allowlist.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/REPLAY-IMPLEMENTATION.md
!/REPLAY-STABILITY.md
!/REPLAY-PORTING-TH01-04.md
!/REPLAY-ACCEPTANCE-2026-10-21.md
!/README-PUBLIC.md
!/server.py
!/lan_server.py
!/lan_relay.py
!/lan_history.py
!/lan_stage_history.py
!/requirements-lan.txt
!/start.bat
!/start-lan.bat
!/start-public.bat
!/web/

# Original disks, extracted files, toolchains, reports, backups and local
# developer notes stay outside the release. Ship only these four game disks.
/web/*.hdi
/web/*.hdi.gz
!/web/th05-local-cn.hdi.gz
!/web/th05-local-jp.hdi.gz
!/web/th05-stage-cn.hdi.gz
!/web/th05-stage-jp.hdi.gz
!/web/th05-solo-cn.hdi.gz
!/web/th05-solo-jp.hdi.gz
/web/disks/
/web/baseline/
/web/build/
/web/extracted/
/web/reports/
/web/screenshots/
/web/backups/
/web/tools/
/web/vendor-source/

# Current entries use DOSBox-X. Retired NP21 resources remain local.
/web/vendor/np2/

# Keep runtime JS/MJS/WASM, music, images, fonts, manifests and licenses.
# Ignore only diagnostics, source maps and experimental build outputs.
/web/**/test-results/
/web/**/playwright-report/
/web/**/*.wat
/web/**/*.lst
/web/**/*.cpuprofile
/web/**/*.heapsnapshot
/web/vendor/**/*.map
/web/vendor/**/*.symbols
/web/vendor/**/*.tgz
/web/vendor/**/*-candidate.wasm
/web/vendor/**/*-probe.wasm
/web/vendor/**/*-dbg.*
/web/**/guest-*.wasm

# Reviewed TH05 core adaptation sources. Toolchains and frozen build inputs
# remain in the full local development workspace, as documented in README.
!/tools/
/tools/*
!/tools/build_th05_idle.mjs
!/tools/build_native_candidate.cjs
!/tools/audit_native_candidate.mjs
!/tools/build_lan_runtime.py
!/tools/snapshot-diff.wat
!/tools/test_external_replay.cjs
!/tools/test_external_replay_codec.mjs
!/tools/test_external_replay_lifecycle.cjs
!/tools/build_frame_replay.py
!/tools/build_frame_replay_core.mjs
!/tools/test_frame_replay.cjs
!/tools/test_frame_replay_codec.mjs
!/tools/test_frame_replay_ending.cjs
!/tools/test_confirmed_history.mjs
!/tools/test_multiplayer_history.cjs
!/tools/test_lan_history.cjs
!/tools/test_history_service.py
!/tools/test_replay_seek.cjs
!/tools/test_replay_flow.cjs
!/tools/test_network_history.cjs
!/tools/analyze_replay_checkpoints.cjs
!/tools/test_frame_replay_bridge.mjs
!/tools/test_solo_replay_ui.cjs
!/tools/test_replay_isolation.cjs
!/tools/test_replay_cheat_policy.cjs
!/tools/test_replay_touch.cjs
!/tools/test_replay_browser_policy.cjs
!/tools/test_browser_replay.cjs
!/tools/test_browser_replay_host.mjs
!/tools/test_legacy_browser_playback.cjs
!/tools/test_portable_checkpoint.cjs
!/tools/test_checkpoint_history.cjs
!/tools/test_checkpoint_builder.mjs
!/tools/build_stage_replay_probe.py
!/tools/build_stage_replay_probe.mjs
!/tools/stage_replay_probe_worker.js
!/tools/stage_replay_probe_state.mjs
!/tools/test_stage_replay.cjs
!/tools/test_stage_replay_state.mjs
!/tools/test_stage_replay_matrix.cjs
!/tools/build_stage_watch_core.mjs
!/tools/stage_watch_test_worker.js
!/tools/test_stage_watch.cjs
!/tools/test_stage_stream.mjs
!/tools/build_replay_menu_font.py
!/tools/unpack_replay_maine.py
!/patches/
/patches/*
!/patches/frame-replay.asm
!/patches/frame-replay-ending.asm

# Caches, editor configuration, credentials and device diagnostics.
__pycache__/
*.py[cod]
node_modules/
.pytest_cache/
.ruff_cache/
.venv/
venv/
.idea/
.vscode/
.env
.env.*
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.swp
*.bak
*.orig
*~
th05-*-fault.json
th05-*-diagnostics.json
